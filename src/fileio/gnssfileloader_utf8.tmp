#ifndef GNSSFILELOADER_H
#define GNSSFILELOADER_H

#include "fileloader.h"
#include "src/common/angle.h"
#include "src/common/types.h"

class GnssFileLoader : public FileLoader {

public:
    GnssFileLoader() = delete;
    explicit GnssFileLoader(const string &filename, int columns = 7) {
        open(filename, columns, FileLoader::TEXT);
    }

    const GNSS &next() {
        data_ = load();

        // 鍩烘湰瀛楁鑷冲皯闇€瑕? time + 3涓綅缃?        if (data_.size() < 4) {
            // 鏁版嵁涓嶈冻锛岃繑鍥炰笂涓€涓€硷紙鎴栭浂锛夛紝閬垮厤瓒婄晫
            return gnss_;
        }

        gnss_.time   = data_[0];
        gnss_.blh[0] = data_[1];
        gnss_.blh[1] = data_[2];
        gnss_.blh[2] = data_[3];

        // std 鍒椾綅缃洿绋冲仴锛?        // - 鑻?n >= 10锛岄€氬父 std 鍦?[7..9]
        // - 鍚﹀垯鑻?n >= 7锛岄€氬父 std 鍦?[4..6]
        // - 鍚﹀垯缃浂
        const size_t n = data_.size();
        if (n >= 10) {
            memcpy(gnss_.std.data(), &data_[7], 3 * sizeof(double));
        } else if (n >= 7) {
            memcpy(gnss_.std.data(), &data_[4], 3 * sizeof(double));
        } else {
            gnss_.std.setZero();
        }
        gnss_.blh[0] *= D2R;
        gnss_.blh[1] *= D2R;

        return gnss_;
    }

private:
    GNSS gnss_;
    vector<double> data_;
};

#endif // GNSSFILELOADER_H
